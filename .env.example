# ─────────────────────────────────────────────────────────────
# poly-btc-5m 环境变量模板
#
# 用法：
#   cp .env.example .env
#   # 填入实际值；启动时 main.rs 会自动 dotenvy::dotenv()
#
# 注意：钱包私钥 / 下单相关参数走 config.toml 的 [wallet] 段，
#       这里只放 Chainlink 鉴权 + 日志 + 运行控制相关。
# ─────────────────────────────────────────────────────────────

# ── Polymarket 钱包私钥（实盘必填，dry-run 留空）─────────────
# hex 字符串，0x 前缀。是否实盘 / dry-run 完全由本变量决定，
# config.toml 中已不再保留 private_key 字段。
# - signature_mode = "eoa"：填 maker 地址对应的 EOA 私钥
# - signature_mode = "safe"：填 Safe proxy owner 的 EOA 私钥
# 留空 = 引擎自动进入 dry-run（main.rs:103）。
POLY_PRIVATE_KEY=

# ── Chainlink Data Streams（必填，结算源对齐）────────────────
# 未配置时 engine 会启动失败（chainlink_ds.rs:74）。
# 若临时想跑 fallback（Binance mid 兜底），需要改代码绕过——
# 不建议生产环境跑无 chainlink 版本。
CHAINLINK_DS_API_KEY=
CHAINLINK_DS_API_SECRET=

# ── Chainlink 可选覆盖（默认即可，不需要改）──────────────────
# CHAINLINK_DS_WS_BASE=wss://ws.dataengine.chain.link
# CHAINLINK_DS_REST_BASE=https://api.dataengine.chain.link
# CHAINLINK_DS_FEED_ID_BTCUSD=0x00039d9e45394f473ab1f050a1b963e6b05351e52d71e507509ada0c95ed75b8

# ── 日志（推荐）─────────────────────────────────────────────
# 不设置 RUST_LOG 时引擎不初始化 tracing-subscriber（main.rs:209）。
RUST_LOG=info
# 设置后日志写到该文件而非 stderr（TUI 模式必填，否则日志会和 TUI 抢屏幕）。
ENGINE_LOG_FILE=engine.log

# ── 运行控制（可选）─────────────────────────────────────────
# HEADLESS=1 跳过 TUI / Web，纯后台跑（main.rs:361）。
# HEADLESS=1
# RUN_SECS=0 表示一直跑；>0 则跑满该秒数后退出（main.rs:362，用于定时回测/冒烟）。
# RUN_SECS=0

# ── Binance API（无需配置）──────────────────────────────────
# 本项目只用 Binance 公开 WS，不调用私有 REST，下面两个变量
# 虽然 config.rs:155 还挂着 env overlay，但下游没人消费，是死代码。
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=
